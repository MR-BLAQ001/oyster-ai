# OYSTER AI environment configuration — EXAMPLE ONLY
# Copy to .env and adjust. NEVER commit real secrets.

# --- Backend (FastAPI) ---
# Keep demo mode ON for local development (disables the owner bearer-token guard).
# Loopback/LAN use only in demo mode — NEVER expose to the public internet.
DEMO_MODE=true

# Owner bearer token required by the API when DEMO_MODE=false.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OWNER_API_TOKEN=

# Local SQLite database path (relative to backend/ working directory)
DATABASE_PATH=./oyster.sqlite3

# Comma-separated CORS allowlist. Never use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
# Public URL of the API as reachable from the browser.
# For Android testing use your Mac's LAN IP, e.g. http://192.168.1.42:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
